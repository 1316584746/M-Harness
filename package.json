{
  "name": "m-harness",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "多模型、可接入办公 OA 的 Agent Harness（引擎 + CLI + 桌面端 + 飞书/钉钉通道）",
  "author": "M-Harness",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness": "./bin/harness.mjs"
  },
  "scripts": {
    "harness": "tsx src/cli/index.ts",
    "dev:serve": "tsx watch src/cli/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.desktop.json",
    "desktop": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:start": "electron-vite preview",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:cli": "node scripts/bundle-cli.mjs",
    "desktop:pack": "node scripts/bundle-cli.mjs && electron-vite build && electron-builder --dir",
    "desktop:dist": "node scripts/bundle-cli.mjs && electron-vite build && electron-builder"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-web": "^1.6.1",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@statsig/js-client": "3.31.0",
    "electron-updater": "^6.8.11",
    "lunar-javascript": "^1.7.8",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@cursor/sdk": "^1.4.0"
  },
  "build": {
    "appId": "com.mharness.desktop",
    "productName": "M-Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@cursor/sdk/**"
    ],
    "extraResources": [
      {
        "from": "build/cli",
        "to": "cli"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "M-Harness <noreply@users.noreply.github.com>",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "1316584746",
      "repo": "M-Harness"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "M-Harness-Setup-${version}.${ext}",
      "allowToChangeInstallationDirectory": true
    }
  }
}
